{
  "schema": 2,
  "required_executas": [
    {
      "tool_id": "bundled:invoice-sanity-check",
      "min_version": "0.1.0",
      "version": "latest"
    }
  ],
  "tags": ["invoice-sanity-check"],
  "system_prompt_addendum": "Invoice Sanity Check reads a pasted invoice or manual line items, then verifies line amounts, subtotal, an optional tax rate, and the total with exact Decimal arithmetic. Open the main view. Do not treat model prose as the arithmetic result. The check_invoice tool result is the only pass or fail.",
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Invoice Sanity Check",
        "default": true,
        "default_size": { "w": 760, "h": 820 },
        "min_size": { "w": 360, "h": 520 },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "tools": ["required:bundled:invoice-sanity-check"],
      "llm": ["complete"],
      "storage": ["get", "set"],
      "window": ["set_title", "ready"]
    },
    "csp_overrides": {},
    "state_merge": "last_writer_wins",
    "form_factors": ["desktop"]
  },
  "dev": {
    "fixtures": [],
    "seed_storage": {},
    "user_id": 1
  }
}
